import Tuple.{Tuple2(..)}

extern pub type Json

/// Cast primitive values to json
@extern
@type (a) -> Json
let wrap

@extern
@type Json
pub let null

@type (Bool) -> Json
pub let bool = wrap

@type (String) -> Json
pub let string = wrap

@type (Float) -> Json
pub let float = wrap

@type (Int) -> Json
pub let int = wrap

@extern
@type ((a) -> Json, List<a>) -> Json
pub let list

@extern
@type (List<Tuple2<String, Json>>) -> Json
pub let object

@extern
@type (Json, Int) -> String
pub let encode
